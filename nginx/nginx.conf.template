worker_processes auto;
error_log /var/log/nginx/error.log warn;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    server_tokens off;

    log_format json escape=json
        '{"time":"$time_iso8601","client":"$remote_addr","method":"$request_method",'
        '"uri":"$request_uri","status":$status,"size":$body_bytes_sent,'
        '"agent":"$http_user_agent","req_time":$request_time,'
        '"upstream":"$upstream_response_time"}';
    access_log /var/log/nginx/access.log json;

    sendfile           on;
    tcp_nopush         on;
    tcp_nodelay        on;
    keepalive_timeout  65;
    proxy_http_version 1.1;

    client_max_body_size    1m;
    client_body_timeout     30s;
    client_header_timeout   10s;
    send_timeout            30s;

    limit_req_zone  $binary_remote_addr zone=default:10m rate=30r/s;
    limit_conn_zone $binary_remote_addr zone=conn:10m;

    include /etc/nginx/upstream.conf;

    server {
        listen      80;
        server_name ${DOMAIN};
        limit_conn  conn 100;

        location = /actuator/health {
            proxy_pass            http://spring_api;
            include               /etc/nginx/proxy.conf;
            proxy_connect_timeout 5s;
            proxy_read_timeout    5s;
            access_log            off;
        }

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen      443 ssl;
        server_name ${DOMAIN};
        http2 on;

        ssl_certificate           /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
        ssl_certificate_key       /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
        ssl_protocols             TLSv1.2 TLSv1.3;
        ssl_ciphers               'ECDHE+AESGCM:ECDHE+CHACHA20:!aNULL:!MD5:!RC4:!3DES';
        ssl_prefer_server_ciphers on;
        ssl_session_cache         shared:SSL:16m;
        ssl_session_timeout       4h;
        ssl_session_tickets       off;
        ssl_stapling              on;
        ssl_stapling_verify       on;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
        add_header X-Content-Type-Options    nosniff                                        always;
        add_header X-Frame-Options           SAMEORIGIN                                     always;
        add_header Referrer-Policy           "strict-origin-when-cross-origin"              always;

        limit_conn conn 100;

        location ~ /\. { deny all; }
        location = /actuator  { deny all; }
        location /actuator/   { deny all; }

        location = /actuator/health {
            proxy_pass            http://spring_api;
            include               /etc/nginx/proxy.conf;
            proxy_connect_timeout 5s;
            proxy_read_timeout    5s;
            access_log            off;
        }

        location / {
            proxy_pass            http://spring_api;
            include               /etc/nginx/proxy.conf;
            limit_req             zone=default burst=50 nodelay;
            proxy_connect_timeout 10s;
            proxy_read_timeout    120s;
            proxy_send_timeout    120s;
        }

        error_page 502 503 /50x.html;
        location = /50x.html { root /usr/share/nginx/html; }
    }
}
